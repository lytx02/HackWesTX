# Copy to server/.env and fill in. server/.env is git-ignored.

# Vultr Managed PostgreSQL. Use the PUBLIC hostname and the connection POOL port.
# uselibpqcompat=true makes sslmode=require encrypt without verifying the chain
# (Vultr signs with its own CA, which Node does not trust by default).
DATABASE_URL=postgresql://campus_app:PASSWORD@PUBLIC_HOST:16751/campus_ai?sslmode=require&uselibpqcompat=true

# For full certificate verification instead: download the CA certificate from the
# database page, set DATABASE_CA_PATH, and drop uselibpqcompat from the URL.
# DATABASE_CA_PATH=./vultr-ca.crt

PORT=4000

# Origin(s) allowed by CORS. Comma-separate to allow several.
# Local dev: http://localhost:5173   Production: https://chalktexas.tech
CORS_ORIGIN=http://localhost:5173
