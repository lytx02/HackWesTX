# Copy to server/.env and fill in. server/.env is git-ignored.

# Vultr Managed PostgreSQL. Use the PUBLIC hostname and the connection POOL port.
# uselibpqcompat=true makes sslmode=require encrypt without verifying the chain
# (Vultr signs with its own CA, which Node does not trust by default).
DATABASE_URL=postgresql://campus_app:PASSWORD@PUBLIC_HOST:16751/campus_ai?sslmode=require&uselibpqcompat=true

# For full certificate verification instead: download the CA certificate from the
# database page, set DATABASE_CA_PATH, and drop uselibpqcompat from the URL.
# DATABASE_CA_PATH=./vultr-ca.crt

PORT=4000

# Origin(s) allowed by CORS. Comma-separate to allow several.
# Local dev: http://localhost:5173   Production: https://chalktexas.tech
CORS_ORIGIN=http://localhost:5173

# ---- vLLM on RunPod (Qwen) ----------------------------------------------
# Leave VLLM_BASE_URL empty to run without a model (canned stub replies).
# Must end in /v1. The two RunPod shapes:
#   Pod (vLLM on port 8000, HTTP port exposed):
#     VLLM_BASE_URL=https://<POD_ID>-8000.proxy.runpod.net/v1
#     VLLM_API_KEY=            # only if vLLM was started with --api-key
#   Serverless vLLM endpoint:
#     VLLM_BASE_URL=https://api.runpod.ai/v2/<ENDPOINT_ID>/openai/v1
#     VLLM_API_KEY=<RunPod API key>
VLLM_BASE_URL=
VLLM_API_KEY=
# Model name as vLLM serves it (the --model or --served-model-name value).
# Never hardcode a guessed Qwen id here: set the exact deployment value. Leave
# blank only for the canned stub replies.
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# Optional tuning. VLLM_DISABLE_THINKING=true turns off Qwen3 "thinking" so
# the stream starts with the answer instead of a reasoning preamble.
# VLLM_MAX_TOKENS=1024
# VLLM_TEMPERATURE=0.7
# VLLM_TIMEOUT_MS=120000
# VLLM_MAX_HISTORY=30
# VLLM_MAX_INPUT_MESSAGES=64
# VLLM_MAX_INPUT_CHARS=60000
# VLLM_DISABLE_THINKING=true
# Daily summaries and digests bound their own inputs and output (summary lines
# are capped at 600 chars each; digests return at most three ranked items), so
# VLLM_MAX_INPUT_CHARS protects every call type including background jobs.

# ---- Daily AI allowance ------------------------------------------------
# Input+output tokens each user (students AND instructors) may spend per day
# across class chats, the floating helper, and professor-triggered
# summary/digest generation. Positive integer; default 50000 when unset;
# invalid values fail at startup. Resets at midnight America/Chicago (DST
# aware). Takes effect on API restart. Automatic nightly summaries are not
# charged to anyone. Set it low (e.g. 2000) to exercise the quota path.
DAILY_TOKEN_LIMIT=50000

# Auth0 (optional). When both are set the API accepts Auth0 access tokens and
# POST /auth/register creates users from Auth0 logins. Leave unset for the
# legacy email + role login only.
# AUTH0_DOMAIN=your-tenant.us.auth0.com
# AUTH0_AUDIENCE=https://chalktexas.tech/api
# AUTH0_REQUIRE_VERIFIED_EMAIL=true   # reject signups until the Auth0 verification email is clicked
# REQUIRE_ACADEMIC_EMAIL=false         # demo: accept any email address, not just .edu-style ones

# Canvas linking (personal access tokens). 32 random bytes, base64, used to
# encrypt tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Leave unset to hide the Connect Canvas card.
# CANVAS_TOKEN_KEY=
