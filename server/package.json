{
  "name": "campus-ai-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --env-file-if-exists=.env src/seed.js",
    "db:studio": "drizzle-kit studio",
    "llm:ping": "node --env-file-if-exists=.env scripts/ping-vllm.js",
    "summary:day": "node --env-file-if-exists=.env scripts/summarize-day.js",
    "summary:catch-up": "node --env-file-if-exists=.env scripts/summarize-day.js --catch-up-days 7",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "drizzle-orm": "^0.36.4",
    "express": "^4.21.1",
    "express-oauth2-jwt-bearer": "^1.10.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.28.1"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.19.12": true
  }
}
