# Frontend settings (Vite). Copy to .env if you need to change the defaults.
# Only VITE_-prefixed values are exposed to the browser; never put secrets here.
VITE_API_URL=http://localhost:4000

# Auth0 (optional). Public values: a SPA client id is not a secret.
# Leave unset to use the legacy email + role demo login.
# VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
# VITE_AUTH0_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_AUTH0_AUDIENCE=https://chalktexas.tech/api
